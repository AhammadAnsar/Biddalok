{
  "name": "biddalok",
  "private": true,
  "version": "1.0.5",
  "description": "Biddalok - School & Institution Management System by SoftDows",
  "author": "Ansar Ahammad (Founder, SoftDows) <ahammadansar75@gmail.com>",
  "homepage": "https://softdows.com/biddalok",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently \"vite --port=3000\" \"wait-on http-get://localhost:3000 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:build:win": "vite build && electron-builder --win nsis portable",
    "electron:build:dir": "vite build && electron-builder --dir"
  },
  "build": {
    "appId": "com.softdows.biddalok",
    "productName": "Biddalok by SoftDows",
    "copyright": "Copyright © 2026 SoftDows. Developed by Ansar Ahammad",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Biddalok by SoftDows",
      "uninstallDisplayName": "Biddalok by SoftDows",
      "runAfterFinish": true,
      "perMachine": true,
      "deleteAppDataOnUninstall": false,
      "allowElevation": true
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.2",
    "tesseract.js": "^7.0.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.1.0"
  }
}